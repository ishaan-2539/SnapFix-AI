      border: "border-danger-100",
      label: "High",
    },
    critical: {
      text: "text-danger-700",
      bg: "bg-danger-50",
      border: "border-danger-100",
      label: "Critical",
    },
  };

  const t = styles[tier];

  return (
    <Badge className={`${t.bg} ${t.text} ${t.border}`}>
      <TrendingUp className="w-3 h-3" />
